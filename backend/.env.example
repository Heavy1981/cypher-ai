# ── CYPHER AI Backend — Environment Variables ──
# Configure no Railway: Settings → Variables

# App
APP_NAME=CYPHER AI
APP_ENV=production
APP_SECRET_KEY=GERE_COM: python -c "import secrets; print(secrets.token_hex(32))"
APP_CORS_ORIGINS=https://cypher-ai.vercel.app,http://localhost:3000

# Supabase (PostgreSQL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Auth
JWT_SECRET_KEY=GERE_COM: python -c "import secrets; print(secrets.token_hex(32))"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# AI
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=4096

# Enrichment (opcional)
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=

# Notificações (opcional)
SLACK_BOT_TOKEN=xoxb-...
SLACK_DEFAULT_CHANNEL=#security-incidents
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Ticketing (opcional)
JIRA_URL=https://yourcompany.atlassian.net
JIRA_USER=
JIRA_API_TOKEN=

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
LOG_LEVEL=INFO
